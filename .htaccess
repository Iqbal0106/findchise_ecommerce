# Selama pengembangan di XAMPP: paksa browser selalu memeriksa ulang berkas
# HTML/JS/CSS, supaya perubahan kode tidak tertinggal di cache browser.
# (Ini penyebab halaman login menjalankan versi lama js/login.js.)
# Boleh dihapus saat naik ke produksi.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header unset Expires
    </FilesMatch>
</IfModule>
